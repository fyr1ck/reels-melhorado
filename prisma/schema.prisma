// Reels Manager — modelo de dados
//
// Convenções desta base:
//
// 1. `accountId` é OBRIGATÓRIO em tudo que pertence a uma conta. Na versão
//    anterior ele era opcional, e vídeos criados sem conta ficavam invisíveis
//    ao agendador (que filtra por conta): entravam na fila e nunca publicavam.
//    Tornar o campo obrigatório move esse erro do runtime para o schema.
//
// 2. O SQLite não tem tipo enum, então estados são String com os valores
//    aceitos documentados na linha acima do campo. Quem valida é
//    server/lib/enums.js, num lugar só.
//
// 3. `onDelete` é explícito em toda relação. Apagar uma conta não pode deixar
//    lixo pendurado nem derrubar o app por violação de chave estrangeira.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// CONTAS
// ============================================================

/// Uma conta do Instagram. Cada uma tem sessão de navegador própria
/// (playwright/session/<id>/), fila, horários e estado de automação.
///
/// O isolamento é apenas de sessão — cookies separados para o app não
/// misturar contas. Não há mascaramento de fingerprint nem navegador
/// anti-detecção: operar muitas contas continua sendo risco de bloqueio.
model Account {
  id       String  @id @default(uuid())
  username String  @unique
  label    String?

  connected       Boolean   @default(false)
  lastConnectedAt DateTime?

  /// Conta desligada não entra no agendador, mesmo conectada.
  enabled Boolean @default(true)
  /// PAUSED | ACTIVE | INTERVENTION
  status  String  @default("PAUSED")

  /// Conta usada pelas telas quando nenhuma está selecionada.
  isDefault Boolean @default(false)

  // --- configuração de publicação, por conta ---
  /// TIMES (horários fixos) | INTERVAL (a cada N minutos) | WINDOW (N por dia
  /// espalhados dentro de uma faixa de horário)
  scheduleMode    String  @default("TIMES")
  intervalMinutes Int     @default(60)

  /// Modo WINDOW: quantos vídeos por dia e entre que horas. É como se pensa o
  /// volume de verdade — "70 por dia das 7h às 23h" — em vez de cadastrar 70
  /// horários à mão.
  postsPerDay Int    @default(20)
  windowStart String @default("07:00")
  windowEnd   String @default("23:00")
  /// Sorteia o próximo vídeo em vez de seguir a ordem da fila.
  randomOrder     Boolean @default(false)

  /// Liga o "Adicionar rótulo de IA" do Instagram antes de publicar.
  /// O Instagram exige esse rótulo em foto e vídeo realistas feitos com IA;
  /// como isso é característica do CONTEÚDO da conta, e não de cada vídeo,
  /// fica aqui e vale para tudo que ela publica.
  aiLabel Boolean @default(false)

  // --- reciclagem de conteúdo ---
  /// Devolve à fila vídeos publicados há mais de N dias. Página de meme não
  /// vive de material inédito: quase ninguém que segue hoje viu o post de dois
  /// meses atrás, e sem isto a conta para quando o acervo acaba.
  recycleEnabled   Boolean @default(false)
  recycleAfterDays Int     @default(30)
  /// Quantas vezes o mesmo vídeo pode voltar. 0 = sem limite.
  recycleMaxTimes  Int     @default(0)

  // --- limites de segurança ---
  /// Máximo de publicações por dia. 0 = sem teto.
  dailyLimit Int @default(0)

  /// Faixa "HH:mm" em que a conta não publica. Pode atravessar a meia-noite
  /// ("23:00" a "07:00"). Publicar de madrugada não bloqueia a conta, mas
  /// desperdiça o vídeo: ele nasce sem audiência.
  quietStart String?
  quietEnd   String?

  /// Aquecimento de conta nova. Publicar 15 reels no primeiro dia é o caminho
  /// mais curto para o bloqueio; a rampa começa em 1/dia e cresce até o alvo.
  /// Null = sem aquecimento.
  warmupStartAt DateTime?
  warmupDays    Int       @default(14)
  warmupTarget  Int       @default(6)
  /// Legenda usada quando o vídeo não tem a própria.
  fallbackCaption String?

  /// Legenda rotativa: a cada N publicações o assistente reescreve a
  /// `fallbackCaption` a partir de `captionSeed` — mesmo formato e idioma,
  /// outro assunto. 0 desliga.
  captionRotateEvery Int @default(0)
  captionRotateCount Int @default(0)
  /// Modelo de onde TODA legenda gerada é copiada. Fixo de propósito: gerar a
  /// partir da última seria telefone sem fio, e em alguns lotes o formato já
  /// não seria o do original.
  captionSeed        String?

  /// Capa padrão DESTA conta. Cada perfil costuma ter identidade visual
  /// própria; uma capa única para a instalação inteira só serve quando há uma
  /// conta só. A resolução é: capa do vídeo > capa da conta > capa geral.
  defaultCoverPath String?
  useDefaultCover  Boolean @default(false)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos       Video[]
  slots        Slot[]
  publications Publication[]
  batches      Batch[]
  watchFolders WatchFolder[]
  niches       AccountNiche[]

  @@index([enabled, status])
}

// ============================================================
// FILA
// ============================================================

/// Um vídeo aguardando publicação, publicando, publicado ou falhado.
model Video {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  filename String
  filepath String
  caption  String?

  /// REEL | STORY
  mediaType String @default("REEL")
  /// PENDING | SCHEDULED | PUBLISHING | PUBLISHED | FAILED
  status    String @default("PENDING")

  durationSec Float?
  /// Float pelo mesmo motivo de ImportedFile.sizeBytes: `Int` no Prisma e de
  /// 32 bits e estoura a partir de 2,1 GB, tamanho comum de video.
  sizeBytes   Float?
  width       Int?
  height      Int?

  /// Capa própria deste vídeo. Vazio = usa a capa padrão da conta, se houver.
  coverPath String?

  /// Posição na fila. Só importa quando a conta não usa ordem aleatória.
  sortOrder Int @default(0)

  /// Impressão digital do arquivo, para detectar o MESMO vídeo em contas
  /// diferentes. É `tamanho-sha1(primeiro MB)`, não o hash do arquivo inteiro:
  /// ler 500 MB por upload travaria a importação, e o primeiro megabyte já
  /// contém cabeçalho e início do stream — dois arquivos distintos praticamente
  /// nunca coincidem nos dois campos ao mesmo tempo.
  contentHash String?

  /// Quantas vezes este vídeo já voltou à fila depois de publicado.
  recycleCount   Int       @default(0)
  /// Última vez que voltou. A carência conta a partir daqui, não de
  /// publishedAt: senão um vídeo reciclado ontem voltaria de novo hoje, já que
  /// a data original continua velha o suficiente para sempre.
  lastRecycledAt DateTime?

  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  failedAt    DateTime?

  publications Publication[]
  importedFrom ImportedFile?

  /// A classificacao por nicho. Opcional de proposito: video que entrou antes
  /// do recurso existir, ou com a classificacao desligada, continua valendo.
  classification ContentClassification?

  @@index([accountId, status, mediaType])
  @@index([accountId, sortOrder])
  @@index([contentHash])
}

/// Vínculo entre um vídeo e um instante de publicação.
model Publication {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  publishedAt DateTime?
  /// SCHEDULED | PUBLISHING | PUBLISHED | FAILED
  status      String    @default("SCHEDULED")

  attempts     Int     @default(0)
  errorMessage String?
  durationMs   Int?

  /// Quando a próxima tentativa pode acontecer. Guardar o instante (em vez de
  /// esperar dentro do processo) mantém o agendador livre: um recuo de 10
  /// minutos não pode impedir as OUTRAS contas de publicarem nesse intervalo.
  nextAttemptAt DateTime?

  createdAt DateTime @default(now())

  @@index([accountId, status, scheduledAt])
  @@index([status, scheduledAt])
}

/// Horário recorrente de publicação. Reels e stories têm grades separadas,
/// então a mesma conta pode postar reel às 12h e story às 12h no mesmo dia.
model Slot {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// "HH:mm"
  time      String
  /// REEL | STORY
  mediaType String  @default("REEL")
  enabled   Boolean @default(true)

  /// Variação aleatória em minutos ao redor de `time`. 0 = horário exato.
  /// Publicar sempre no minuto cravado é um padrão facilmente reconhecível.
  jitterMinutes Int @default(0)

  createdAt DateTime @default(now())

  @@unique([accountId, time, mediaType])
  @@index([accountId, enabled])
}

// ============================================================
// BIBLIOTECA DE CONTEÚDO
// ============================================================

/// Legenda reutilizável. `weight` faz uma legenda boa sair mais vezes no
/// rodízio sem precisar cadastrá-la duplicada.
model Caption {
  id        String   @id @default(uuid())
  text      String
  label     String?
  enabled   Boolean  @default(true)
  weight    Int      @default(1)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, usedCount])
}

/// Grupo de hashtags. `raw` guarda o texto como o usuário digitou; a
/// normalização (# e deduplicação) acontece na leitura.
model HashtagSet {
  id        String   @id @default(uuid())
  name      String
  raw       String
  enabled   Boolean  @default(true)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, usedCount])
}

// ============================================================
// EDITOR EM MASSA
// ============================================================

/// Template visual reutilizável. `config` é um JSON com a estrutura completa.
model Template {
  id        String   @id @default(uuid())
  name      String
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches Batch[]
  items   BatchItem[]
}

/// Um lote: N vídeos de origem + 1 template.
model Batch {
  id         String   @id @default(uuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// Conta de destino dos vídeos gerados.
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// PENDING | RUNNING | DONE | CANCELLED | FAILED
  status    String @default("PENDING")
  mediaType String @default("REEL")

  total     Int @default(0)
  done      Int @default(0)
  failed    Int @default(0)
  cancelled Int @default(0)

  concurrency  Int     @default(2)
  autoQueue    Boolean @default(true)
  autoSchedule Boolean @default(false)

  /// Aplica pequenas variações entre as cópias (corte, zoom, posição), para
  /// N contas não publicarem arquivos byte a byte idênticos.
  varyOutputs Boolean @default(false)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  items BatchItem[]

  @@index([status])
}

/// Um vídeo dentro de um lote: origem -> resultado.
model BatchItem {
  id         String   @id @default(uuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  sourceName String
  sourcePath String
  outputName String?
  outputPath String?

  /// PENDING | RUNNING | DONE | FAILED | CANCELLED
  status       String  @default("PENDING")
  progress     Int     @default(0)
  errorMessage String?

  queuedVideoId String?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([batchId, status])
}

/// Vídeo enviado ao editor, antes de virar lote.
model SourceVideo {
  id          String   @id @default(uuid())
  filename    String
  filepath    String
  durationSec Float?
  /// Float pelo mesmo motivo de ImportedFile.sizeBytes: `Int` no Prisma e de
  /// 32 bits e estoura a partir de 2,1 GB, tamanho comum de video.
  sizeBytes   Float?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())
}

// ============================================================
// PASTAS MONITORADAS
// ============================================================

/// Pasta do disco observada. Se for a pasta que o Google Drive / OneDrive /
/// Dropbox sincroniza, o efeito é o de importar direto da nuvem — sem OAuth.
model WatchFolder {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  path  String  @unique
  label String?

  enabled Boolean @default(true)
  /// COPY (mantém o original) | MOVE (remove da origem)
  mode    String  @default("COPY")
  /// REEL | STORY — tipo com que os importados entram na fila.
  mediaType String @default("REEL")
  /// Já aplica uma legenda da biblioteca na importação.
  autoCaption Boolean @default(false)

  lastScanAt    DateTime?
  lastError     String?
  importedCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imports ImportedFile[]

  @@index([enabled])
}

/// Registro do que já foi importado, para o mesmo arquivo não entrar duas
/// vezes. A identidade é (pasta + caminho + tamanho + mtime).
///
/// `mtimeMs` é INTEIRO de propósito: guardado como REAL, a fração se perde no
/// round-trip do SQLite (…112.9119 volta …112.912) e qualquer comparação
/// feita em JS falha. Inteiros até 2^53 são exatos em double.
model ImportedFile {
  id            String      @id @default(uuid())
  watchFolderId String
  watchFolder   WatchFolder @relation(fields: [watchFolderId], references: [id], onDelete: Cascade)

  sourcePath String

  /// Float, e não Int, nos dois: `Int` no Prisma é de 32 bits, e nenhum dos
  /// dois cabe lá. `mtimeMs` é um instante em milissegundos — passou de
  /// 2.147.483.647 em 2038 no formato de segundos e há muito mais tempo em
  /// milissegundos, então TODA varredura falhava com "does not fit in an INT
  /// column". `sizeBytes` estoura no mesmo lugar a partir de 2,1 GB, que é
  /// tamanho de vídeo perfeitamente comum.
  ///
  /// Float aqui é um double: representa inteiros exatos até 2^53, muito além
  /// do necessário. BigInt resolveria o alcance, mas volta como BigInt no
  /// cliente e BigInt não sobrevive a JSON.stringify — quebraria as respostas
  /// da API em vez da varredura.
  sizeBytes  Float
  mtimeMs    Float

  videoId String? @unique
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  importedAt DateTime @default(now())

  @@unique([watchFolderId, sourcePath, sizeBytes, mtimeMs])
  @@index([watchFolderId])
}

// ============================================================
// SISTEMA
// ============================================================

/// Preferências que valem para a instalação inteira (linha única, id = 1).
/// Tudo que é por conta mora em Account — este modelo guarda só o que
/// realmente não pertence a nenhuma delas.
model Settings {
  id Int @id @default(1)

  /// Reaproveita a janela do navegador entre publicações.
  keepBrowserOpen Boolean @default(false)

  /// Recusa um vídeo cujo conteúdo já está na fila de OUTRA conta. Ligado por
  /// padrão: publicar o mesmo arquivo em dois perfis é o padrão mais visível de
  /// automação, e o segundo post não ganha alcance nenhum.
  blockDuplicateContent Boolean @default(true)

  /// Legenda de último recurso para a instalação inteira. Só entra quando o
  /// vídeo não tem legenda própria e a conta não tem a dela.
  defaultCaption String?

  /// Capa aplicada a novos vídeos que não trazem a própria nem a da conta.
  defaultCoverPath String?
  useDefaultCover  Boolean @default(false)

  // --- avisos fora do painel ---
  /// Token de um bot do Telegram (criado no @BotFather) e o id do chat.
  /// Sem isto, uma conta que pausa às 3h da manhã só é descoberta quando
  /// alguém abre o painel — com a fila parada desde então.
  telegramBotToken String?
  telegramChatId   String?
  /// POST com JSON, para quem já usa Discord, n8n ou Make.
  webhookUrl       String?
  /// Avisar também quando dá certo. Desligado por padrão: quem publica 20
  /// vezes por dia não quer 20 mensagens.
  notifyOnSuccess  Boolean @default(false)

  // --- controle remoto por WhatsApp ---
  /// Desligado por padrão. Ligado, os avisos vão para o WhatsApp e o número
  /// abaixo pode dar comandos.
  whatsappEnabled Boolean @default(false)
  /// O ÚNICO número atendido — o do DONO, para onde os avisos vão e de quem os
  /// comandos são aceitos (ex: 5516994441788). É diferente do número que
  /// escaneia o QR: aquele é o "telefone do bot", e pode ser outro chip.
  /// Mensagem de qualquer outra conversa é ignorada sem resposta.
  whatsappNumber  String?

  /// Roda o navegador do WhatsApp sem janela visível. Ligado por padrão: uma
  /// aba do Chromium aberta o dia inteiro atrapalha quem usa a máquina, e o QR
  /// é capturado e mostrado no painel de qualquer jeito.
  whatsappHeadless Boolean @default(true)

  // --- assistente de código (API do Claude) ---
  /// Desligado por padrão: nada sai desta máquina sem alguém ligar.
  assistantEnabled  Boolean @default(false)
  /// Chave da API. `ANTHROPIC_API_KEY` no .env tem prioridade sobre esta, e é
  /// o lugar preferível — o banco vira backup, e chave em backup vaza.
  assistantApiKey   String?
  assistantModel    String  @default("claude-sonnet-5")
  /// Aplicar a correção sem perguntar. Desligado por padrão: escrever no
  /// código de um app em execução pode deixá-lo sem subir.
  assistantAutoApply Boolean @default(false)

  // --- separacao por nichos ---
  /// Desligado por padrao. Ligado, cada video que entra na fila e classificado
  /// e a publicacao passa pela validacao de compatibilidade.
  nicheEnabled Boolean @default(false)
  /// Nota minima para APROVADO e para REVISAO. Abaixo da segunda, BLOQUEADO.
  /// Configuraveis porque o rigor certo depende do nicho de quem usa.
  nicheApproveScore Int @default(90)
  nicheReviewScore  Int @default(70)
  /// Impedir de fato a publicacao do que ficou BLOQUEADO. Separado de
  /// `nicheEnabled` para dar um periodo de observacao: da para classificar e
  /// so olhar os numeros antes de deixar o sistema barrar publicacao.
  nicheBlockPublish Boolean @default(true)
  /// Usar a API do Claude ja configurada para refinar a classificacao. As
  /// regras rodam sempre; a IA so entra quando ha chave e isto esta ligado.
  nicheUseAi Boolean @default(false)

  autoCleanCache      Boolean   @default(false)
  autoCleanEveryHours Int       @default(24)
  lastCacheCleanAt    DateTime?

  updatedAt DateTime @updatedAt
}

/// Auditoria. Toda ação relevante passa por aqui.
model LogEntry {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  /// INFO | SUCCESS | WARN | ERROR
  level   String @default("INFO")
  /// Ação em SCREAMING_SNAKE (ex: PUBLICACAO_CONCLUIDA)
  action  String
  message String?

  accountId String?
  videoName String?
  attempt   Int?
  durationMs Int?

  @@index([createdAt])
  @@index([level, createdAt])
}

// ============================================================
// NICHOS
// ============================================================

/// Um nicho definido PELO USUARIO.
///
/// Nao ha lista fixa no codigo: "Emagrecimento", "Religiao" ou "Cortes de
/// Podcast" sao linhas desta tabela, criadas pelo painel. Adicionar um nicho
/// novo nunca exige mexer no codigo.
model Niche {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  category    String?

  /// Listas no formato que o usuario digitou, uma por linha ou separadas por
  /// virgula. Mesma escolha do HashtagSet.raw: normalizar so na leitura
  /// preserva o texto exatamente como ele escreveu, e continua editavel.
  subniches      String @default("")
  keywords       String @default("")
  bannedKeywords String @default("")
  allowedThemes  String @default("")
  bannedThemes   String @default("")
  /// Uma regra por linha, em portugues corrente. Ex: "Nao aceitar promessas de
  /// perda de peso rapida." Entram no prompt da IA e, quando ha palavras
  /// reconheciveis, tambem na pontuacao por regras.
  customRules    String @default("")

  audience String?
  tone     String?

  /// Desempata quando dois nichos pontuam igual. Maior ganha.
  priority Int @default(0)
  /// BAIXO | MEDIO | ALTO — o quanto uma palavra proibida derruba a nota.
  strictness String @default("MEDIO")
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        AccountNiche[]
  classifications ContentClassification[]

  @@index([active, priority])
}

/// Liga um nicho a uma conta que JA EXISTE.
///
/// Tabela de ligacao em vez de campo em Account de proposito: a conta tem um
/// nicho principal e quantos secundarios quiser, e nada do modelo Account
/// precisou mudar para isso.
model AccountNiche {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nicheId   String
  niche     Niche   @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  /// Um principal por conta; o resto e secundario. Quem garante a unicidade e
  /// a camada de nichos, nao o banco: SQLite nao tem indice parcial no Prisma.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([accountId, nicheId])
  @@index([nicheId])
}

/// O resultado da classificacao de UM video.
///
/// Fica em tabela propria, e nao em colunas de Video, porque a fila existente
/// nao pode depender dela: sem classificacao o video continua publicando
/// exatamente como antes.
model ContentClassification {
  id      String @id @default(uuid())
  videoId String @unique
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  /// O nicho vencedor. Nulo quando nenhum alcancou nota suficiente.
  nicheId String?
  niche   Niche?  @relation(fields: [nicheId], references: [id], onDelete: SetNull)

  /// 0 a 100.
  score Float @default(0)
  /// APROVADO | REVISAO | BLOQUEADO | SEM_CLASSIFICACAO
  status String @default("SEM_CLASSIFICACAO")

  /// JSON: a nota de CADA nicho, para a tela mostrar o ranking inteiro.
  /// [{ nicheId, name, score, motivos: [...] }]
  scores String @default("[]")
  /// JSON: os motivos do nicho vencedor. E a explicacao que o usuario pediu —
  /// "por que 98%" precisa ter resposta.
  reasons String @default("[]")

  /// A conta que a classificacao recomenda. Nao publica sozinha: quem decide
  /// continua sendo a fila existente.
  recommendedAccountId String?

  /// REGRAS | IA — de onde veio a nota final.
  source String @default("REGRAS")

  /// Quando alguem decidiu manualmente na tela de revisao.
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([nicheId])
}
