# Porta da API
PORT=3001

# Banco SQLite (relativo a prisma/)
DATABASE_URL="file:./data/app.db"

# Pasta raiz dos vídeos
VIDEOS_DIR=./videos

# Sessões do Playwright, uma pasta por conta
SESSION_DIR=./playwright/session

# false = navegador visível. Recomendado: você precisa ver a janela para
# resolver CAPTCHA ou 2FA quando o Instagram pedir.
HEADLESS=false

# Agendador
SCHEDULER_TICK_MS=15000
MAX_ATTEMPTS=3
SCHEDULE_DAYS_AHEAD=14

# Pastas monitoradas
WATCH_SCAN_MS=120000
# Tempo que um arquivo precisa ficar parado antes de ser importado.
# Sincronizadores de nuvem criam o arquivo com o tamanho final antes de
# terminar de baixá-lo; sem essa espera, um vídeo truncado entra na fila.
WATCH_SETTLE_MS=15000

MAX_UPLOAD_MB=500

# Assistente de código (opcional). Chave da API da Anthropic, em
# console.anthropic.com > API Keys. Colocada aqui, ela NÃO passa pelo banco e
# nunca entra no backup — é o lugar preferível. É paga por uso.
# ANTHROPIC_API_KEY=sk-ant-...
