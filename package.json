{
  "name": "reels-manager",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Painel local para fila, edição em massa e publicação automatizada de Reels do Instagram.",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=./server server/index.js",
    "dev:web": "npm run dev --prefix client",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "build": "npm run build --prefix client",
    "test": "node --test tests/*.test.js",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "setup": "npm install && npm install --prefix client && prisma generate && prisma migrate deploy && playwright install chromium"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "prisma": "^5.22.0"
  }
}
